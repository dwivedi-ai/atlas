diff --git a/tests/test_reports.py b/tests/test_reports.py
index b25240c..a0c9b75 100644
--- a/tests/test_reports.py
+++ b/tests/test_reports.py
@@ -112,3 +112,19 @@ def test_register_replaces_a_name(ledger: Ledger):
         assert run("transaction-log", ledger) is marker
     finally:
         register("transaction-log", original)
+
+
+def test_trial_balance_converts_into_one_currency(ledger: Ledger, rates):
+    report = run(
+        "trial-balance",
+        ledger,
+        ReportOptions(period=Period.parse("2024-Q4"), convert_to="USD", rates=rates),
+    )
+    assert set(report.column("currency")) == {"USD"}
+    assert report.meta["converted"] is True
+    assert report.meta["converted_to"] == "USD"
+
+
+def test_trial_balance_conversion_needs_rates(ledger: Ledger):
+    with pytest.raises(ReportError):
+        run("trial-balance", ledger, ReportOptions(convert_to="USD"))
