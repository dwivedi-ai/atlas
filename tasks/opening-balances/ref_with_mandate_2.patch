diff --git a/ledgerline/ledger.py b/ledgerline/ledger.py
index 0f52d7b..e78e10d 100644
--- a/ledgerline/ledger.py
+++ b/ledgerline/ledger.py
@@ -182,6 +182,18 @@ class Ledger:
             p.amount for p in scope.postings(account, include_children=include_children)
         )
 
+
+    def balance_before(
+        self, account: str, when: date, *, currency: str | None = None
+    ) -> Money:
+        """Balance of ``account`` strictly before ``when``.
+
+        The brought-forward figure an account statement starts from when it is
+        asked for a period rather than for the whole ledger.
+        """
+        prior = self.filter(lambda t: t.date < when)
+        return prior.balance(account, include_children=True, currency=currency)
+
     def balances(
         self, *, period: Period | None = None, leaves_only: bool = True
     ) -> "OrderedDict[str, dict[str, Money]]":
