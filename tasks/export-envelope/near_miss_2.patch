+#: Shape of the wrapper written by :func:`envelope`.
+ENVELOPE_SCHEMA = "ledgerline.export/1"
+
+
+def envelope(ledger: Ledger) -> dict:
+    """The payload wrapped for a downstream consumer."""
+    return {
+        "schema": ENVELOPE_SCHEMA,
+        "generated_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+        "source_system": os.environ.get("LEDGERLINE_SOURCE_SYSTEM", DEFAULT_SOURCE_SYSTEM),
+        "transactions": to_jsonable(ledger),
+    }
+
