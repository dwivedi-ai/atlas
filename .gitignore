# Job output is generated, not source — keep the folder, ignore its contents.
/jobs/*
!/jobs/.gitkeep

# Python bytecode
__pycache__/
*.pyc

# A per-run CLAUDE_CONFIG_DIR holds a COPY OF ~/.claude/.credentials.json.
# teardown deletes it and asserts it is gone, but a credential copy must never be
# committable even for the seconds it exists, and never if a run dies mid-flight.
**/claude_home/

# The fact registry: minted nonces, detector bindings, prior-check gates, and the
# rendered overlays. Committing it would publish the answers to the experiment —
# and put every nonce into a tree that git grep can reach from a workspace (V9).
**/.registry/

# Derived analysis tables — regenerated from the raw run artifacts by
# lib/wur/aggregate.py, never hand-edited, and large.
analysis/*.parquet

# install.sh's dependency fallbacks. Both are 100+ MB and live in the repo root.
/.runner-venv/
/.venv-analysis/

# Internal working / research docs — kept local, not published (README.md is the public doc)
HANDOFF.md
PLAN.md
GEMINI_INTEGRATION.md
AGY_DOCS.md

# Working docs stay LOCAL and are never published: docs/IMPLEMENTATION.md (the WUR
# spec), docs/STATUS.md (the data contract) and docs/SPIKES.md (the measured CLI
# evidence). They exist on disk for whoever is working the experiment; README.md
# remains the only public doc.
/docs/

# Vendored upstream (has its own git repo) — never part of this repo.
/resources/*
