@@ -307,7 +308,44 @@ def transaction_log(ledger: Ledger, options: ReportOptions) -> Report:
     )
 
 
+def cashflow(ledger: Ledger, options: ReportOptions) -> Report:
+    """Net movement of the cash subtree, one row per month and currency."""
+    root = options.account or "assets.cash"
+    scope = options.scoped(ledger)
+    buckets: dict[tuple[str, str], list[Money]] = {}
+    for transaction in scope:
+        month = f"{transaction.date.year}-{transaction.date.month:02d}"
+        for posting in transaction.postings:
+            if not is_under(posting.account, root):
+                continue
+            buckets.setdefault((month, posting.amount.currency), []).append(
+                posting.amount
+            )
+
+    rows: list[list[str]] = []
+    for (month, currency), amounts in sorted(buckets.items()):
+        inflow = sum(a.minor for a in amounts if a.minor > 0)
+        outflow = sum(-a.minor for a in amounts if a.minor < 0)
+        rows.append(
+            [
+                month,
+                currency,
+                _fmt(Money(inflow, currency)),
+                _fmt(Money(outflow, currency)),
+                _fmt(Money(inflow - outflow, currency)),
+            ]
+        )
+    return Report(
+        name="cashflow",
+        title=f"Cash flow ({_period_label(options)})",
+        columns=("month", "currency", "inflow", "outflow", "net"),
+        rows=rows,
+        meta={"root": root, "months": sorted({m for m, _ in buckets})},
+    )
+
+
 register("trial-balance", trial_balance, doc=trial_balance.__doc__ or "")
+register("cashflow", cashflow, doc=cashflow.__doc__ or "")
 register("account-statement", account_statement, doc=account_statement.__doc__ or "")
 register("income-statement", income_statement, doc=income_statement.__doc__ or "")
 register("balance-sheet", balance_sheet, doc=balance_sheet.__doc__ or "")
