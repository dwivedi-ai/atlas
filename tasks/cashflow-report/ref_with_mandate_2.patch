+"""The cash-flow report.
+
+Kept in its own module because it is the only report with a month axis, and
+because a report that walks postings rather than balances reads better without
+the ageing helpers around it.
+"""
+
+from __future__ import annotations
+
+from .accounts import is_under
+from .ledger import Ledger
+from .money import Money
+from .reports import Report, ReportOptions
+
+
+def cashflow(ledger: Ledger, options: ReportOptions) -> Report:
+    """Net movement of the cash subtree, one row per month and currency."""
+    root = options.account or "assets.cash"
+    scope = options.scoped(ledger)
+    buckets: dict[tuple[str, str], list[Money]] = {}
+    for transaction in scope:
+        month = f"{transaction.date.year}-{transaction.date.month:02d}"
+        for posting in transaction.postings:
+            if not is_under(posting.account, root):
+                continue
+            buckets.setdefault((month, posting.amount.currency), []).append(posting.amount)
+
+    rows: list[list[str]] = []
+    for (month, currency), amounts in sorted(buckets.items()):
+        inflow = sum(a.minor for a in amounts if a.minor > 0)
+        outflow = sum(-a.minor for a in amounts if a.minor < 0)
+        rows.append(
+            [
+                month,
+                currency,
+                Money(inflow, currency).format(with_currency=False),
+                Money(outflow, currency).format(with_currency=False),
+                Money(inflow - outflow, currency).format(with_currency=False),
+            ]
+        )
+    return Report(
+        name="cashflow",
+        title=f"Cash flow ({options.period.label if options.period else 'all dates'})",
+        columns=("month", "currency", "inflow", "outflow", "net"),
+        rows=rows,
+        meta={"root": root, "months": sorted({m for m, _ in buckets})},
+    )
