diff --git a/tests/test_reports.py b/tests/test_reports.py
index b25240c..6aef8ca 100644
--- a/tests/test_reports.py
+++ b/tests/test_reports.py
@@ -112,3 +112,19 @@ def test_register_replaces_a_name(ledger: Ledger):
         assert run("transaction-log", ledger) is marker
     finally:
         register("transaction-log", original)
+
+
+def test_account_statement_brings_a_balance_forward(ledger: Ledger):
+    december = ReportOptions(
+        account="assets.cash.checking", period=Period.parse("2024-12"), opening=True
+    )
+    report = run("account-statement", ledger, december)
+    assert report.meta["opening"] is True
+    assert report.meta["closing"] == ledger.balance("assets.cash.checking").minor
+
+
+def test_account_statement_without_opening_starts_from_zero(ledger: Ledger):
+    december = ReportOptions(account="assets.cash.checking", period=Period.parse("2024-12"))
+    report = run("account-statement", ledger, december)
+    assert report.meta["opening"] is False
+    assert report.meta["closing"] != ledger.balance("assets.cash.checking").minor
