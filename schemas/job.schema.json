{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job.schema.json",
  "title": "JobSpec",
  "description": "One exp-runner job: a repo + a task + a natural-language acceptance description + a model.",
  "type": "object",
  "required": ["schema_version", "job_id", "repo", "task", "accept", "model"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "job_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },

    "repo": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["url"] }, { "required": ["path"] }],
      "properties": {
        "url":        { "type": "string" },
        "path":       { "type": "string" },
        "ref":        { "type": "string", "default": "HEAD" },
        "pinned_sha": { "type": ["string", "null"] }
      }
    },

    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stack":    { "type": "string", "enum": ["auto", "python", "node", "none"], "default": "auto" },
        "command":  { "type": ["string", "null"] },
        "detected": { "type": ["string", "null"] }
      }
    },

    "task":   { "type": "string", "minLength": 1 },
    "accept": { "type": "string", "minLength": 1 },

    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task", "accept"],
        "properties": {
          "id":     { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "task":   { "type": "string", "minLength": 1 },
          "accept": { "type": "string", "minLength": 1 }
        }
      }
    },

    "model":  { "type": "string", "enum": ["codex", "claude", "claude-sonnet-4-6", "gemini", "gemini-2.5-pro", "gemini-2.5-flash", "gemini-2.5-flash-lite", "agy", "agy-flash-low", "agy-flash-med", "agy-flash-high", "agy-pro-low", "agy-pro-high", "agy-sonnet", "agy-opus", "agy-gpt-oss"] },
    "reps":   { "type": "integer", "minimum": 1, "default": 1 },
    "max_seconds": { "type": "integer", "minimum": 0, "default": 0 },
    "judge_votes": { "type": "integer", "minimum": 1, "default": 1 },
    "analyze": { "type": "boolean", "default": true },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"] },
      "default": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"]
    }
  }
}
